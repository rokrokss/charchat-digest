<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rokrokss.charchat-digest-web</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/rokrokss/.claude/routines/digest-server.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/rokrokss/.claude/routines/logs/digest-web.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rokrokss/.claude/routines/logs/digest-web.err.log</string>
</dict>
</plist>
